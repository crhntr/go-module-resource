#!/bin/sh

set -eu
exec 3>&1
exec 1>&2

payload=$(cat)

module_path=$(printf '%s' "$payload" | jq -r '.source.module // ""')
source_proxy=$(printf '%s' "$payload" | jq -r '.source.proxy // ""')
include_pre=$(printf '%s' "$payload" | jq -r '.source.include_prerelease // false')
proxy="${source_proxy:-https://proxy.golang.org}"

[ -n "$module_path" ] || { echo "source.module is required"; exit 1; }

sort_flags=""
[ "$include_pre" = "true" ] || sort_flags="--no-prerelease"

curl --silent --fail-with-body -L "${proxy}/${module_path}/@v/list" \
  | semver-sort $sort_flags \
  | jq -Rs 'split("\n") | map(select(length > 0) | {version: .})' >&3
